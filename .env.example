NODE_ENV=development
PORT=4000

# Absolute or repo-relative path. Do NOT hard-code a machine-specific path in prod.
DATABASE_PATH=./data/itsupporter.sqlite

# JWT — MUST be replaced with a long random secret in production.
JWT_ACCESS_SECRET=replace_me_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_me_with_a_long_random_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5172
PUBLIC_BASE_URL=http://localhost:5172
API_BASE_URL=http://localhost:4000

# Upload
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# Late policy & configurable thresholds (admin can change via system_settings)
LATE_PENALTY_MINUTES=10
LATE_PENALTY_PERCENT=15
FREE_SERVICE_AFTER_MINUTES=45

# Business constants
# Giờ Việt Nam (UTC+7) = giờ Hà Nội. IANA duy nhất hợp lệ: Asia/Ho_Chi_Minh
TIMEZONE=Asia/Ho_Chi_Minh
WORKING_START=07:00
WORKING_END=19:00
SLOT_DURATION_MINUTES=60

# Backup
BACKUP_DIR=./database/backups